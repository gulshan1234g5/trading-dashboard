# Frontend
VITE_API_BASE=/api

# FastAPI service
GT_ENV=development
GT_SESSION_SECRET=
GT_PASSPHRASE_HASH=
GT_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
GT_SESSION_TTL_MINUTES=30
GT_COOKIE_SECURE=0
GT_STATE_FILE=.data/paper-ledger.json
GT_LOGIN_MAX_ATTEMPTS=6
GT_LOGIN_WINDOW_SECONDS=300

# Broker and engine integration remains disabled in this build.
